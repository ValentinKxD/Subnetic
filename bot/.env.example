# Скопіюйте у bot/.env і заповніть. Файл .env не комітиться.

# Токен від @BotFather (той самий, що TELEGRAM_BOT_TOKEN у server/.env)
TELEGRAM_BOT_TOKEN=

# Шлях до SQLite сервера; відносний — від папки bot/
DB_PATH=../server/data/subnetic.db

# Часовий пояс для remind_hour і «сьогодні»
TZ=Europe/Kyiv
